table Results
	lineageTag: 63e0e468-56bc-4620-b7db-88f7b4f71a2e

	measure Races = ```
			DISTINCTCOUNT ( Results[race_id] )
			
			```
		formatString: 0
		lineageTag: 1471da9c-38ce-44c8-9840-d1701100301f

	measure Entries = ```
			COUNTROWS ( Results )
			
			```
		formatString: 0
		lineageTag: 150d6761-174c-4598-8015-307cc794bb7e

	measure Wins = ```
			CALCULATE ( COUNTROWS ( Results ), Results[won] = TRUE () )
			
			```
		formatString: 0
		lineageTag: e67d1d10-7081-4140-854e-ad95e62102cb

	measure Podiums = ```
			CALCULATE ( COUNTROWS ( Results ), Results[podium] = TRUE () )
			
			```
		formatString: 0
		lineageTag: 3e9bc154-5a93-4558-8523-74cb64da5621

	measure 'Win Rate' = ```
			DIVIDE ( [Wins], [Entries] )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a045fb4d-ad8d-47bf-a93a-e804b1f23df6

	measure 'Finish Rate' = ```
			DIVIDE ( CALCULATE ( COUNTROWS ( Results ), Results[outcome] = "Running at finish" ), [Entries] )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 240e2a18-dcf2-465a-8a46-6cf6ffea257a

	measure 'Pole Conversion' = ```
			DIVIDE ( CALCULATE ( COUNTROWS ( Results ), Results[pole] = TRUE (), Results[won] = TRUE () ), CALCULATE ( COUNTROWS ( Results ), Results[pole] = TRUE () ) )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9c9ac22f-573f-4375-bd17-490d3e19c4fc

	measure HHI = ```
			SUMX ( VALUES ( Results[team] ), ( 100 * DIVIDE ( CALCULATE ( [Wins] ), CALCULATE ( [Wins], ALL ( Results[team] ) ) ) ) ^ 2 )
			
			```
		formatString: 0
		lineageTag: 250a8c77-51cd-4ab2-a676-a63b4601fc3e

	measure 'Effective Winning Teams' = ```
			DIVIDE ( 10000, [HHI] )
			
			```
		formatString: 0.00
		lineageTag: 58ed4d7b-c44a-4946-90e5-510d669d9848

	measure 'Model MAE' = ```
			AVERAGE ( Predictions[abs_error] )
			
			```
		formatString: 0.00
		lineageTag: f871f1e2-1834-442b-b985-cb36415666d0

	measure 'Grid Baseline MAE' = ```
			AVERAGE ( Predictions[grid_baseline_error] )
			
			```
		formatString: 0.00
		lineageTag: 7ed4d8a6-49ad-4047-8fdb-bb6e060cece8

	measure 'Model R2' = ```
			VAR m = AVERAGE ( Predictions[actual_position] ) RETURN 1 - DIVIDE ( SUMX ( Predictions, ( Predictions[actual_position] - Predictions[predicted_position] ) ^ 2 ), SUMX ( Predictions, ( Predictions[actual_position] - m ) ^ 2 ) )
			
			```
		formatString: 0.00
		lineageTag: f6266c5b-7bbe-4441-a1cb-5a16b1c97e77

	measure 'Winning Constructors' = ```
			CALCULATE ( DISTINCTCOUNT ( Results[team] ), Results[won] = TRUE () )
			
			```
		formatString: 0
		lineageTag: f7266c5b-7bbe-4441-a1cb-5a16b1c97e78

	measure 'Winning Drivers' = ```
			CALCULATE ( DISTINCTCOUNT ( Results[driver_id] ), Results[won] = TRUE () )
			
			```
		formatString: 0
		lineageTag: f8266c5b-7bbe-4441-a1cb-5a16b1c97e79

	measure 'MAE Improvement' = ```
			DIVIDE ( [Grid Baseline MAE] - [Model MAE], [Grid Baseline MAE] )
			
			```
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: f9266c5b-7bbe-4441-a1cb-5a16b1c97e7a

