                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Test Set (2024–25): The regression model achieves a Mean Absolute Error of 2.50 positions, beating the naive Grid Baseline of 2.72 positions by +8.1% (R² = 0.60).",
                    "textStyle": {
                      "fontSize": "9pt",
